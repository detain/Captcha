        "spam-prevention",
        "bot-protection",
        "human-verification",
        "visual-captcha",
        "image-captcha",
        "gd",
        "security",
        "php-captcha",
        "recaptcha"
    ],
    "homepage": "https://github.com/Gregwar/Captcha",
    "license": "MIT",
    "authors": [
        {
            "name": "Grégoire Passault",
            "email": "g.passault@gmail.com",
            "homepage": "http://www.gregwar.com/"
        },
        {
            "name": "Jeremy Livingston",
            "email": "jeremy.j.livingston@gmail.com"
        }
    ],
    "require": {
        "php": ">=5.3.0",
        "ext-gd": "*",
        "ext-mbstring": "*",
